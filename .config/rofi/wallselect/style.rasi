/* WallSelect - Floating Carousel Theme (matching img-ejemplo.png) */

@import "../colors.rasi"

* {
    font:                 "JetBrainsMono Nerd Font Bold 10";
}

/* Main Window Setup */
window {
    enabled:              true;
    fullscreen:           false;
    location:             center;
    anchor:               center;
    width:                94%;
    max-width:            1550px;
    transparency:         "real";
    cursor:               "default";
    spacing:              0px;
    padding:              24px 12px;
    border:               0px;
    background-color:     transparent;
}

/* Main Box Container */
mainbox {
    enabled:              true;
    spacing:              10px;
    children:             [ "inputbar", "listview" ];
    background-color:     transparent;
}

/* Top Floating Pill Header Bar */
inputbar {
    enabled:              true;
    margin:               0px 25%;
    spacing:              12px;
    padding:              8px 18px;
    border-radius:        20px;
    border:               1px;
    border-color:         @outline-variant;
    background-color:     @surface-container-high;
    text-color:           @on-surface;
    children:             [ "prompt", "entry" ];
}

prompt {
    enabled:              true;
    padding:              2px 12px;
    border-radius:        20px;
    background-color:     @primary-container;
    text-color:           @on-primary-container;
    font:                 "JetBrainsMono Nerd Font Bold 10";
}

entry {
    enabled:              true;
    background-color:     transparent;
    text-color:           @on-surface;
    cursor:               text;
    placeholder:          "SEARCH_WALLPAPER // INPUT...";
    placeholder-color:    @outline;
    font:                 "JetBrainsMono Nerd Font SemiBold 10";
    horizontal-align:     0.5;
    vertical-align:       0.5;
}

/* Horizontal Strip Carousel Listview */
listview {
    enabled:              true;
    columns:              5;
    lines:                1;
    spacing:              5px;
    padding:              0px 4px;
    cycle:                true;
    dynamic:              true;
    scrollbar:            false;
    layout:               vertical;
    reverse:              false;
    fixed-height:         true;
    fixed-columns:        true;
    cursor:               "default";
    background-color:     transparent;
    text-color:           @on-surface;
}

/* Individual Vertical Wallpaper Strip Card */
element {
    enabled:              true;
    orientation:          vertical;
    children:             [ "element-icon", "element-text" ];
    spacing:              8px;
    padding:              8px;
    border-radius:        20px;
    border:               1px;
    border-color:         transparent;
    cursor:               pointer;
    background-color:     @surface-container-low;
    text-color:           @on-surface;
}

element normal.normal {
    background-color:     @surface-container-low;
    text-color:           @on-surface;
}

element selected.normal {
    background-color:     @primary-container;
    border:               1px;
    border-color:         @primary;
    text-color:           @on-primary-container;
}

element-icon {
    size:                 430px;
    cursor:               inherit;
    border-radius:        2px;
    horizontal-align:     0.5;
    vertical-align:       0.5;
    background-color:     transparent;
}

element-text {
    vertical-align:       0.5;
    horizontal-align:     0.5;
    cursor:               inherit;
    background-color:     transparent;
    text-color:           inherit;
    font:                 "JetBrainsMono Nerd Font Bold 9";
}

/* Error Message UI */
error-message {
    text-color:           @on-surface;
    background-color:     @surface;
    children:             [ "textbox" ];
}

textbox {
    text-color:           inherit;
    background-color:     inherit;
    vertical-align:       0.5;
    horizontal-align:     0.5;
}
