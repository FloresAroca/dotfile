[
    {
        "layer": "top",
        "position": "top",
        "height": 40,
        "modules-left": [
            "custom/arch"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
        	"tray",
            "hyprland/workspaces"
        ],
        "cpu": {
            "interval": 2,
            "format": "󰍛 {usage}%",
            "tooltip": false
        },
        "memory": {
            "interval": 2,
            "format": "󰘚 {percentage}%",
            "tooltip-format": "RAM usada: {used:0.1f}G / {total:0.1f}G"
        },
        "temperature": {
            "interval": 2,
            "critical-threshold": 75,
            "format": "{icon} {temperatureC}°C",
            "format-icons": [
                "",
                "",
                ""
            ]
        },
        "custom/arch": {
            "format": "󰣇",
            "tooltip": false
        },
        "hyprland/workspaces": {
            "disable-scroll": true,
            "all-outputs": true,
            "on-click": "activate",
            "format": "{name}",
            "persistent-workspaces": {
                "*": [
                    1,
                    2,
                    3,
                    4
                ]
            }
        },
        "clock": {
            "format": "󰸗 {:%d %b  |  󱑒 %H:%M}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟 Muted",
            "format-icons": {
                "default": [
                    "󰕿",
                    "󰖀",
                    "󰕾"
                ]
            },
            "on-click": "pavucontrol"
        },
        "bluetooth": {
            "format": "󰂯",
            "format-disabled": "󰂲",
            "format-connected": "󰂱 {num_connections}",
            "tooltip-format": "{controller_alias}\t{controller_address}",
            "tooltip-format-connected": "{controller_alias}\n\nConectado a:\n{device_enumerate}",
            "tooltip-format-enumerate-connected": " {device_alias}",
            "on-click": "blueman-manager"
        },
        "battery": {
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-charging": "󱐋 {capacity}%",
            "format-icons": [
                "󰂎",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "tray": {
            "icon-size": 16,
            "spacing": 10
        },
        "custom/spotify-controls": {
            "format": "󰒮      ",
            "return-type": "json",
            "exec": "~/.config/waybar/scripts/spotify-controls.sh",
            "interval": 1,
            "on-click": "~/.config/waybar/scripts/spotify-click.sh play",
            "on-click-middle": "~/.config/waybar/scripts/spotify-click.sh next",
            "on-click-right": "~/.config/waybar/scripts/spotify-click.sh previous"
        }
    },
    {
        "layer": "bottom",
        "position": "bottom",
        "height": 30,
        "margin-top": 0,
        "spacing": 15,
        "modules-center": [
            "group/hardware"
        ],
        "group/hardware": {
            "orientation": "horizontal", // Puede ser vertical también
            "modules": [
                "cpu",
                "memory",
                "temperature",
                "battery",
                "pulseaudio"
            ]
        },
        "cpu": {
            "interval": 2,
            "format": "󰍛 {usage}%",
            "tooltip": false
        },
        "memory": {
            "interval": 2,
            "format": "󰘚 {percentage}%",
            "tooltip-format": "RAM usada: {used:0.1f}G / {total:0.1f}G"
        },
        "temperature": {
            "interval": 2,
            "critical-threshold": 75,
            "format": "{icon} {temperatureC}°C",
            "format-icons": [
                "",
                "",
                ""
            ]
        },
        "battery": {
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-charging": "󱐋 {capacity}%",
            "format-icons": [
                "󰂎",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟 Muted",
            "format-icons": {
                "default": [
                    "󰕿",
                    "󰖀",
                    "󰕾"
                ]
            },
            "on-click": "pavucontrol"
        },
    }
]
