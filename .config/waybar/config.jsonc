{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 5,
  "margin-left": 5,
  "margin-right": 5,
  "modules-left": ["custom/arch", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "pulseaudio", "battery", "network"],
  "cpu": {
    "interval": 2,
    "format": "󰍛 {usage}%",
    "tooltip": false,
  },
  "memory": {
    "interval": 2,
    "format": "󰘚 {percentage}%",
    "tooltip-format": "RAM usada: {used:0.1f}G / {total:0.1f}G",
  },
  "network": {
    "format-wifi": "󰤨 ",
    "format-ethernet": "󰈀 ",
    "format-linked": "󰈀 Disc",
    "format-disconnected": "󰤭 Desc",
    "tooltip": false,
  },
  "temperature": {
    "interval": 2,
    "critical-threshold": 75,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""],
  },
  "custom/arch": {
    "format": "󰣇",
    "tooltip": false,
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "on-click": "activate",
    "format": "{name}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4],
    },
  },
  "clock": {
    "format": "󰸗 {:%a %d %b  󱑒 %H:%M}",
    "tooltip-format": "<big><tt>{calendar}</tt></big>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#a7c8ff'><b>{}</b></span>",
        "days": "<span color='#e1e2e9'><b>{}</b></span>",
        "weeks": "<span color='#bdc7dc'><b>W{}</b></span>",
        "weekdays": "<span color='#dbbde2'><b>{}</b></span>",
        "today": "<span color='#111318' background='#a7c8ff'><b> {} </b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "pavucontrol",
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\n\nConectado a:\n{device_enumerate}",
    "tooltip-format-enumerate-connected": " {device_alias}",
    "on-click": "blueman-manager",
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10,
  },
}
