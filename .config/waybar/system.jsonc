{
  "layer": "bottom",
  "position": "bottom",
  "margin-top": 0,
  "margin-left": 5,
  "margin-right": 5,
  "margin-bottom": 5,
  "height": 30,
  "spacing": 15,
  "modules-center": ["group/hardware"],
  "group/hardware": {
    "orientation": "horizontal", // Puede ser vertical también
    "modules": ["cpu", "memory", "temperature"],
  },
  "cpu": {
    "interval": 2,
    "format": "󰍛 {usage}%",
    "tooltip": false,
  },
  "memory": {
    "interval": 2,
    "format": "󰘚 {percentage}%",
    "tooltip-format": "RAM usada: {used:0.1f}G / {total:0.1f}G",
  },
  "temperature": {
    "interval": 2,
    "critical-threshold": 75,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""],
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "pavucontrol",
  },
}
